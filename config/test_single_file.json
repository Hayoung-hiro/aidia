{
  "project_metadata": {
    "project_name": "Test_Single_File_With_Viz",
    "date": "2025-11-03",
    "description": "Test config-based pipeline with Stage 4 visualization",
    "analyst": "Test"
  },

  "input_data": {
    "input_files": [
      "data/90min_report.parquet"
    ],
    "current_cycle_time": 2.0
  },

  "instrument": {
    "preset": "fusion_lumos",
    "custom_settings": null
  },

  "dppp_parameters": {
    "target_dppp": 7.0,
    "target_satisfaction": 0.70,
    "dppp_tolerance": 0.0
  },

  "scan_settings": {
    "load_factor": 0.8,
    "ms1_scans_per_cycle": null,
    "warning_threshold_windows": 5
  },

  "rt_binning": {
    "rt_bin_width_min": 5.0
  },

  "mz_optimization": {
    "strategies": ["greedy", "quantile"],
    "quantile_lower": 0.05,
    "quantile_upper": 0.95,
    "target_coverage": 0.95,
    "outlier_threshold": 3.0,
    "smoothing_window": 3,
    "polynomial_order": 2
  },

  "window_generation": {
    "modes": ["variable"],
    "min_width_da": 2,
    "max_width_da": 80,
    "overlap_percentage": 0
  },

  "output": {
    "output_dir": "results_test_single_viz",
    "include_summary": true,
    "include_plots": true
  }
}
