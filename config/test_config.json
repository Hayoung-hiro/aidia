{
  "project_metadata": {
    "project_name": "JSON_Workflow_Test",
    "date": "2025-10-27",
    "description": "Quick test of JSON-based workflow with 30min gradient only",
    "analyst": "Test"
  },

  "input_data": {
    "input_files": [
      "data/30min_report.parquet"
    ]
  },

  "instrument": {
    "preset": "fusion_lumos",
    "custom_settings": null
  },

  "dppp_parameters": {
    "target_dppp": 7.0,
    "target_satisfaction": 0.70,
    "dppp_tolerance": 0.0
  },

  "scan_settings": {
    "load_factor": 0.8,
    "ms1_scans_per_cycle": null,
    "warning_threshold_windows": 5
  },

  "rt_binning": {
    "rt_bin_width_min": 5.0
  },

  "mz_optimization": {
    "strategies": ["quantile"],
    "quantile_lower": 0.05,
    "quantile_upper": 0.95,
    "target_coverage": 0.95,
    "outlier_threshold": 3.0,
    "smoothing_window": 3,
    "polynomial_order": 2
  },

  "window_generation": {
    "modes": ["fixed"],
    "min_width_da": 2,
    "max_width_da": 80,
    "overlap_percentage": 0
  },

  "output": {
    "output_dir": "results_json_test",
    "include_summary": true,
    "include_plots": false
  }
}
